# Hexbloop — Electron audio engine

# Node / Electron
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (keep the macOS entitlements plist)
build/
!build/entitlements.mac.plist

# Electron distribution (keep docs/scripts, ignore built artifacts)
dist/*.zip
dist/*.dmg
dist/*.blockmap
dist/*.yml
dist/mac-arm64/

# Vendor binaries (downloaded via `npm run vendor:setup`, not committed)
vendor/mac/
vendor/win/
vendor/linux/

# Hexbloop output directory
HexbloopOutput/

# Local / secrets / OS cruft
.env
.aider*
.DS_Store
