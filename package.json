{
  "name": "hexbloop-electron",
  "productName": "Hexbloop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "npm run vendor:setup && electron-builder --mac dmg --arm64 --publish never",
    "build:local-candidate": "node scripts/build-local-candidate.js",
    "test": "node test/audio-processing.test.js && node test/name-generation.test.js && node test/artwork-generation.test.js && node test/output-path.test.js && node test/release-hardening.test.js && node test/controls.test.js",
    "test:controls": "node test/controls.test.js",
    "test:phase-b": "node test/controls.test.js && node test/phase-b-matrix.test.js",
    "test:phase-c": "node test/phase-c.test.js",
    "test:phase-d": "node test/phase-d-discovery.test.js && node test/phase-d-main.test.js && NODE_PATH=\"$(npm root -g)\" node test/phase-d-ui.test.js",
    "benchmark:phase-d": "node test/phase-d-benchmark.test.js",
    "benchmark:phase-d:electron": "electron test/electron-benchmark.js",
    "test:e2e": "node test/pipeline-e2e.test.js",
    "test:release-provenance": "python3 -B test/release-provenance.test.py && node test/prepare-release.test.js",
    "test:local-packaged": "NODE_PATH=\"$(npm root -g)\" node test/local-packaged.test.js",
    "test:hud": "NODE_PATH=\"$(npm root -g)\" node test/hud.test.js",
    "test:settings": "NODE_PATH=\"$(npm root -g)\" node test/settings-experience.test.js",
    "dist": "npm run build",
    "dist:all": "echo 'Commercial release is arm64 macOS only; use npm run dist' >&2; exit 1",
    "clean": "rm -rf node_modules package-lock.json",
    "clean:install": "npm run clean && npm install",
    "postinstall": "electron-builder install-app-deps",
    "vendor:setup": "node scripts/download-vendor-binaries.js"
  },
  "keywords": [
    "audio",
    "music",
    "processing",
    "hexagon",
    "mystical",
    "chaos",
    "magic"
  ],
  "author": "Hexbloop Audio Labs",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/pibulus/hexbloop.git"
  },
  "description": "🔮 Hexbloop - Chaos Magic Audio Engine. Transform your audio with mystical digital processing influenced by natural forces.",
  "build": {
    "appId": "com.hexbloop.audio",
    "productName": "Hexbloop",
    "afterPack": "scripts/prepare-release.js",
    "afterSign": "scripts/notarize-release.js",
    "afterAllArtifactBuild": "scripts/staple-release.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**",
      "build/entitlements.mac.plist",
      "!test/**",
      "!docs/**",
      "!**/*.test.js",
      "!*_AUDIT_*.md",
      "!AUDIT_REPORT.md",
      "!README.md",
      "!GLOSSARY.md",
      "!CLAUDE.md",
      "!docs/**",
      "!dist/**",
      "!*.log",
      "!.git/**",
      "!assets/favicon*",
      "!assets/apple-touch-icon.png",
      "!assets/icon-192.png",
      "!assets/icon-512.png",
      "!assets/manifest.json"
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "minimumSystemVersion": "15.0",
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "notarize": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "vendor/mac/",
          "to": "vendor/mac/"
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "vendor/win/",
          "to": "vendor/win/"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets",
      "extraResources": [
        {
          "from": "vendor/linux/",
          "to": "vendor/linux/"
        }
      ]
    }
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  }
}
